generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SINDICO
  PORTEIRO
  MORADOR
}

enum EmployeeRole {
  PORTEIRO
  ZELADOR
  LIMPEZA
  MANUTENCAO
}

enum TaskStatus {
  SOLICITADA_MORADOR
  BACKLOG
  IN_PROGRESS
  CANCELED
  DONE
}

enum VehicleType {
  CARRO
  MOTO
  UTILITARIO
  BICICLETA
}

enum PostCategory {
  AVISO
  PENSAMENTO
  CLASSIFICADO
}

model User {
  id        String   @id @default(uuid())
  cpf       String   @unique
  name      String
  email     String?
  password  String
  role      Role     @default(MORADOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  ddd       String?
  phone     String?
  residentType String @default("MORADOR")
  
  reservations Reservation[]
  visitors     Visitor[]
  occurrences  Occurrence[]
  posts        Post[]
  postLikes    PostLike[]
  postComments PostComment[]
  syndicMessages SyndicMessage[]
  tasks        Task[]
}

model Employee {
  id        String       @id @default(uuid())
  name      String
  cpf       String       @unique
  birthDate DateTime?
  email     String?      @unique
  password  String?      
  phone     String?
  role      EmployeeRole
  shift     String?      
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Maintenance {
  id                String   @id @default(uuid())
  title             String
  description       String?
  observation       String?
  performedAt       DateTime
  nextMaintenanceAt DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Task {
  id             String     @id @default(uuid())
  number         Int?
  title          String
  description    String?
  status         TaskStatus @default(BACKLOG)
  performedAt    DateTime?
  attachmentUrl  String?    @db.Text
  attachmentName String?
  
  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  unitId         String?
  unit           Unit?      @relation(fields: [unitId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Unit {
  id            String         @id @default(uuid())
  block         String   
  number    String   
  residents     User[]
  vehicles      Vehicle[]
  parkingSpaces ParkingSpace[]
  authorizations Authorization[]
  ballroomReservations BallroomReservation[]
  syndicMessages SyndicMessage[]
  tasks         Task[]
}

model BallroomReservation {
  id              String    @id @default(uuid())
  unitId          String
  unit            Unit      @relation(fields: [unitId], references: [id])
  name            String
  cpf             String?
  rg              String?
  ddd             String?
  phone           String?
  date            DateTime
  notes           String?   // Observação do solicitante
  adminNotes      String?   // Observação do administrador
  status          String    @default("SOLICITADO") // SOLICITADO, EFETIVADO, CANCELADO
  requesterCpf    String?
  guests          BallroomGuest[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model BallroomGuest {
  id              String              @id @default(uuid())
  reservationId   String
  reservation     BallroomReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  name            String
  cpf             String?
}

model Vehicle {
  id        String      @id @default(uuid())
  plate     String      @unique
  model     String
  color     String
  type      VehicleType @default(CARRO)
  unitId    String
  unit      Unit        @relation(fields: [unitId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ParkingSpace {
  id        String   @id @default(uuid())
  number    String
  block     String
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
}

model Reservation {
  id        String   @id @default(uuid())
  area      String   
  date      DateTime
  startTime DateTime
  endTime   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("PENDING") 
}

model Visitor {
  id        String   @id @default(uuid())
  name      String
  document  String   
  qrCode    String?  @unique 
  validUntil DateTime?
  hostId    String
  host      User     @relation(fields: [hostId], references: [id])
  logs      AccessLog[]
}

model AccessLog {
  id        String   @id @default(uuid())
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id])
  type      String   
  timestamp DateTime @default(now())
  notes     String?
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  authorId  String   
}

model Occurrence {
  id        String   @id @default(uuid())
  title     String
  description String
  photoUrl  String?
  status    String   @default("OPEN") 
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Authorization {
  id               String    @id @default(uuid())
  unitId           String
  unit             Unit      @relation(fields: [unitId], references: [id])
  name             String
  rg               String?
  cpf              String?
  ddd              String?
  phone            String?
  hasGarageAccess  Boolean   @default(false)
  vehiclePlate     String?
  vehicleModel     String?
  vehicleColor     String?
  entryDate        DateTime?
  exitDate         DateTime?
  notes            String?
  companions       AuthorizationCompanion[]
  requesterCpf     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SyndicMessage {
  id              String   @id @default(uuid())
  number          Int      @default(autoincrement())
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   
  otherType       String?  
  description     String   @db.Text
  attachmentUrl   String?
  status          String   @default("PENDENTE") 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuthorizationCompanion {
  id              String        @id @default(uuid())
  authorizationId String
  authorization   Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  name            String
  rg              String?
  cpf             String?
}

model Post {
  id          String       @id @default(uuid())
  title       String
  description String
  category    PostCategory
  price       Float?
  images      String[]     @default([])
  expiresAt   DateTime?
  isArchived  Boolean      @default(false)
  
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  
  likes       PostLike[]
  comments    PostComment[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PostComment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([postId, userId])
}
model Document {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  fileUrl     String   @db.Text
  fileName    String
  fileSize    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  phones        String?  @db.Text  // JSON array: [{ddd:"11", phone:"99999-9999"}, ...]
  email         String?
  specialty     String?
  document      String?  // CPF or CNPJ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Package {
  id              String    @id @default(uuid())
  unitId          String
  unit            Unit      @relation(fields: [unitId], references: [id])
  residentId      String
  resident        User      @relation(fields: [residentId], references: [id])
  type            String    // Caixa, Envelope, Pacote, Delivery, Outros
  size            String?   // pequena, média, grande
  carrier         String?   // Transportadora / Remetente
  observations    String?   @db.Text
  conciergeName   String    // Nome do Porteiro
  receivedAt      DateTime  @default(now())
  status          String    @default("RECEBIDO PORTARIA") // RECEBIDO PORTARIA, RETIRADO
  withdrawnAt     DateTime?
  withdrawnBy     String?   // Nome de quem retirou
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
